{
  "name": "@happydesigns/id",
  "type": "module",
  "version": "0.2.4",
  "private": false,
  "packageManager": "pnpm@12.8.1",
  "author": "happydesigns",
  "description": "Brand authoring, app previews and native brand layers for Nuxt UI.",
  "homepage": "https://id.happydesigns.de",
  "repository": {
    "type": "git",
    "url": "https://github.com/happydesigns/id.git"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./preview": {
      "types": "./dist/preview-module.d.ts",
      "import": "./dist/preview-module.js"
    },
    "./nuxt": "./nuxt.layer.config.mjs",
    "./guide": "./guide/nuxt.config.mjs",
    "./studio": "./studio/nuxt.config.mjs",
    "./studio/core": {
      "types": "./dist/src/studio.d.ts",
      "import": "./dist/src/studio.js"
    },
    "./defaults": {
      "types": "./dist/src/defaults.d.ts",
      "import": "./dist/src/defaults.js"
    },
    "./schema": {
      "types": "./dist/src/schema.d.ts",
      "import": "./dist/src/schema.js"
    },
    "./examples": {
      "types": "./dist/src/examples.d.ts",
      "import": "./dist/src/examples.js"
    },
    "./adapters/nuxt-ui": {
      "types": "./dist/src/adapters/nuxt-ui.d.ts",
      "import": "./dist/src/adapters/nuxt-ui.js"
    },
    "./adapters/css-variables": {
      "types": "./dist/src/adapters/css-variables.d.ts",
      "import": "./dist/src/adapters/css-variables.js"
    },
    "./themes/nuxt-ui": {
      "types": "./dist/themes/nuxt-ui/index.d.ts",
      "import": "./dist/themes/nuxt-ui/index.js"
    },
    "./themes/sample-brand": {
      "types": "./dist/themes/sample-brand/index.d.ts",
      "import": "./dist/themes/sample-brand/index.js"
    },
    "./themes/sample-brand/tokens.css": "./dist/themes/sample-brand/tokens.css",
    "./package.json": "./package.json",
    "./devtools": {
      "types": "./dist/devtools-module.d.ts",
      "import": "./dist/devtools-module.js"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "app",
    "guide",
    "studio",
    "src",
    "themes",
    "nuxt.layer.config.ts",
    "nuxt.layer.config.mjs",
    "README.md",
    "LICENSE",
    "scripts/prepare-studio-package.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "nuxt dev playground",
    "build": "nuxt build playground",
    "build:package": "node scripts/build-package.mjs",
    "generate:example": "node scripts/generate-example.mjs",
    "preview": "nuxt preview playground",
    "docs": "nuxt dev docs",
    "docs:build": "nuxt generate docs",
    "docs:preview": "nuxt preview docs",
    "dev:prepare": "pnpm build:package && pnpm generate:example && nuxt prepare && nuxt prepare playground && nuxt prepare docs && nuxt prepare templates/brand-layer && nuxt prepare templates/themed-app",
    "prepack": "pnpm build:package",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && nuxt typecheck playground && nuxt typecheck docs && nuxt typecheck templates/brand-layer && nuxt typecheck templates/themed-app",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm test && pnpm typecheck",
    "verify:full": "pnpm verify && pnpm test:nuxt && pnpm test:browser && pnpm test:package && pnpm test:docs && pnpm test:devtools && pnpm test:preview",
    "pack:studio": "pnpm pack --out .output/studio-package/id.tgz",
    "test:prepare": "pnpm build:package && nuxt prepare",
    "test:nuxt": "pnpm test:prepare && vitest run --config vitest.nuxt.config.ts",
    "test:browser": "pnpm test:prepare && playwright test",
    "test:docs": "pnpm test:prepare && playwright test --config playwright.docs.config.ts",
    "test:package": "pnpm test:prepare && pnpm pack:studio && playwright test --config playwright.package.config.ts",
    "test:devtools": "pnpm test:prepare && playwright test --config playwright.devtools.config.ts",
    "test:preview": "pnpm test:prepare && playwright test --config playwright.preview.config.ts",
    "release:preview": "changelogen --no-output",
    "release": "(npm whoami || npm login) && pnpm release:prepare && pnpm publish && git push --follow-tags",
    "release:prepare": "pnpm verify:full && changelogen --release --no-github --clean"
  },
  "dependencies": {
    "@nuxt/devtools-kit": "^3.4.2",
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/ui": "catalog:",
    "h3": "^1.15.11",
    "nuxt": "catalog:",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@iconify-json/lucide": "catalog:",
    "@iconify-json/simple-icons": "^1.2.98",
    "@iconify-json/vscode-icons": "catalog:",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "1.63.0",
    "@vue/compiler-sfc": "3.5.43",
    "changelogen": "^0.6.2",
    "docus": "catalog:",
    "eslint": "^10.11.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "^5.0.2",
    "vue": "3.5.43",
    "vue-tsc": "catalog:",
    "yaml": "^2.9.1"
  },
  "bin": {
    "id-studio-package": "./scripts/prepare-studio-package.mjs"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  }
}
