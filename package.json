{
  "name": "@happydesigns/id",
  "type": "module",
  "version": "0.1.0",
  "private": false,
  "packageManager": "pnpm@10.33.0",
  "author": "happydesigns",
  "description": "Reusable identity contracts, Nuxt UI theme runtime, and brand-layer tooling for happydesigns projects.",
  "homepage": "https://id.happydesigns.de",
  "repository": {
    "type": "git",
    "url": "https://github.com/happydesigns/id.git"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./nuxt": "./nuxt.layer.config.mjs",
    "./defaults": {
      "types": "./dist/src/defaults.d.ts",
      "import": "./dist/src/defaults.js"
    },
    "./schema": {
      "types": "./dist/src/schema.d.ts",
      "import": "./dist/src/schema.js"
    },
    "./examples": {
      "types": "./dist/src/examples.d.ts",
      "import": "./dist/src/examples.js"
    },
    "./themes/nuxt-ui": {
      "types": "./dist/themes/nuxt-ui/index.d.ts",
      "import": "./dist/themes/nuxt-ui/index.js"
    },
    "./themes/happydesigns": {
      "types": "./dist/themes/happydesigns/index.d.ts",
      "import": "./dist/themes/happydesigns/index.js"
    },
    "./themes/happydesigns/tokens.css": "./dist/themes/happydesigns/tokens.css"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "app",
    "src",
    "themes",
    "templates/brand-layer/app",
    "templates/brand-layer/public",
    "templates/brand-layer/brand.ts",
    "templates/brand-layer/nuxt.config.ts",
    "templates/brand-layer/package.json",
    "templates/brand-layer/README.md",
    "templates/brand-layer/tsconfig.json",
    "templates/themed-app/app",
    "templates/themed-app/nuxt.config.ts",
    "templates/themed-app/package.json",
    "templates/themed-app/README.md",
    "templates/themed-app/tsconfig.json",
    "nuxt.layer.config.ts",
    "nuxt.layer.config.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "nuxt dev playground",
    "build": "nuxt build playground",
    "build:package": "node scripts/build-package.mjs",
    "preview": "nuxt preview playground",
    "docs": "nuxt dev docs",
    "docs:build": "nuxt generate docs",
    "docs:preview": "nuxt preview docs",
    "prepare": "pnpm build:package && nuxt prepare && nuxt prepare playground && nuxt prepare docs && nuxt prepare templates/brand-layer && nuxt prepare templates/themed-app",
    "prepack": "pnpm build:package && pnpm test && pnpm typecheck",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && nuxt typecheck playground && nuxt typecheck docs && nuxt typecheck templates/brand-layer && nuxt typecheck templates/themed-app",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.2",
    "@nuxt/ui": "^4.8.0",
    "nuxt": "^4.4.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.102",
    "@iconify-json/simple-icons": "^1.2.78",
    "@nuxt/eslint": "^1.15.2",
    "@vue/compiler-sfc": "^3.5.31",
    "docus": "^5.12.2",
    "eslint": "^10.2.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16",
    "vue-tsc": "^3.2.6"
  }
}
