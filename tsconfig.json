{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "types": [
      "vitest/globals"
    ]
  },
  "files": [],
  "include": [
    ".nuxt/imports.d.ts",
    ".nuxt/types/imports.d.ts",
    ".nuxt/types/vue-shim.d.ts",
    "app/components/**/*.ts",
    "app/components/**/*.vue",
    "app/composables/**/*.ts",
    "app/plugins/**/*.ts",
